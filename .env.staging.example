# ============================================================================
# KODERA ACADEMY — STAGING / VERCEL PREVIEW Environment Template (kodera-dev)
# ============================================================================
# Placeholders ONLY — NEVER commit real credentials to Git.
# Configure these in Vercel Project Settings -> Environment Variables with
# scope set to "Preview" ONLY (do NOT assign kodera-dev keys to Production).
# For local testing against kodera-dev, copy into `.env.local` (git-ignored).
# ============================================================================

# --- PUBLIC FRONTEND VARIABLES (safe for browser bundle; bounded by RLS) ---
VITE_SUPABASE_URL=https://YOUR-KODERA-DEV-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-KODERA-DEV-ANON-PUBLISHABLE-KEY
VITE_APP_NAME=Kodera
VITE_APP_URL=https://YOUR-VERCEL-PREVIEW-URL.vercel.app

# NEVER enable local sandbox in Staging/Preview or Production
VITE_LOCAL_SANDBOX=false

# --- SERVER-ONLY VARIABLES (Vercel Functions ONLY — NEVER prefix with VITE_) ---
SUPABASE_URL=https://YOUR-KODERA-DEV-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-KODERA-DEV-ANON-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-KODERA-DEV-SERVICE-ROLE-SECRET-KEY
APP_URL=https://YOUR-VERCEL-PREVIEW-URL.vercel.app

# NEVER enable local sandbox in Staging/Preview or Production
KODERA_LOCAL_SANDBOX=false
