# ============================================================================
# KODERA ACADEMY — Environment Variables Template
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or any real credentials to Git.
# ============================================================================

# --- PUBLIC FRONTEND VARIABLES (safe for browser bundle; bounded by RLS) ---
VITE_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
VITE_APP_NAME=Kodera Academy
VITE_APP_URL=http://localhost:5173

# Optional: Set to 'true' ONLY in local development / Playwright tests when
# running without a live Supabase project (strictly ignored in production builds).
VITE_LOCAL_SANDBOX=false

# --- SERVER-ONLY VARIABLES (Vercel Functions ONLY — NEVER prefix with VITE_) ---
SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
APP_URL=http://localhost:5173

# --- OFFICIAL ADMIN AUTHENTICATION & PUBLIC CONTACT EMAIL SEPARATION ---
# Dedicated admin login email (authentication ONLY — never exposed publicly):
ADMIN_LOGIN_EMAIL=koderaaz@gmail.com
# Public student contact email & transactional sender metadata:
ACADEMY_CONTACT_EMAIL=muhammed.ehmedov94@gmail.com
SMTP_SENDER_NAME=Kodera Academy
SMTP_FROM_EMAIL=muhammed.ehmedov94@gmail.com
# Configure real SMTP credentials in Supabase Dashboard (Auth -> SMTP) or Vercel Server Env:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Dev/test-only local sandbox flag for server handlers (NEVER set in production)
KODERA_LOCAL_SANDBOX=false
